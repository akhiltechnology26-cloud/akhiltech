{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akhiltech",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "*.akhiltechnology.com/*",
      "zone_name": "akhiltechnology.com"
    }
  ],
  "vars": {
    "RESEND_FROM_EMAIL": "gethelp@akhiltechnology.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFpIB57ODJH0IY73"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "contact_submissions",
      "database_id": "2571ea88-52c0-49ac-ad4d-c509b03969e4",
      "migrations_dir": "./migrations"
    }
  ]
}
